# Stripe Setup - Not Committed to Git
# Copy this file to .env and fill in your keys

# ======================================
# FRONTEND (Vite - public key)
# ======================================
VITE_STRIPE_PUBLIC_KEY=pk_test_51...your_stripe_public_key_here
VITE_META_PIXEL_ID=1581408896866645

# ======================================
# BACKEND (Netlify Functions - secret keys)
# ======================================
# NEVER commit these to Git!
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_secret_here
PAYMENT_STATUS_SIGNING_SECRET=...your_random_32_plus_character_secret_here

# ======================================
# SUPABASE
# ======================================
SUPABASE_URL=https://dllckokqkgcraxyxsfqc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...your_service_role_key_here
INTERNAL_FUNCTION_SECRET=...your_random_32_plus_character_secret_here
CRON_SECRET=...your_random_32_plus_character_secret_here
RESEND_API_KEY=re_...your_resend_api_key_here
RESEND_VERIFIED_DOMAIN=geobooker.com.mx
CRM_DEFAULT_FROM_NAME=Geobooker Ads
CRM_DEFAULT_FROM_ADDRESS=hola@geobooker.com.mx
CRM_REPLY_TO_EMAIL=hola@geobooker.com.mx
RESEND_WEBHOOK_SECRET=whsec_...your_resend_webhook_signing_secret_here

# ======================================
# NETLIFY
# ======================================
URL=https://your-site.netlify.app

# CRM 2.0 staging review (read-only UI; disabled unless explicitly enabled)
VITE_CRM2_IMPORT_REVIEW_ENABLED=false

# Server-side kill switch for the CRM staging Edge Function
CRM2_IMPORT_DRY_RUN_ENABLED=false

# CRM 2.0 operational overview (read-only UI)
VITE_CRM2_OPERATIONS_ENABLED=false

# CRM 2.0 account/contact directory (PII-minimized read-only UI)
VITE_CRM2_DIRECTORY_ENABLED=false
VITE_TT_STORAGE_DISCOVERY_ENABLED=false
