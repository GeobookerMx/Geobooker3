# Client-safe configuration
VITE_STRIPE_PUBLIC_KEY=pk_test_...your_publishable_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=...your_anon_key_here
URL=https://www.geobooker.com.mx

# Server-only secrets. Configure these in the deployment provider; never commit values.
STRIPE_SECRET_KEY=sk_test_...your_server_secret_here
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_secret_here
PAYMENT_STATUS_SIGNING_SECRET=...your_random_32_plus_character_secret_here
SUPABASE_SERVICE_ROLE_KEY=...your_service_role_key_here
INTERNAL_FUNCTION_SECRET=...your_random_32_plus_character_secret_here
CRON_SECRET=...your_random_32_plus_character_secret_here
RESEND_WEBHOOK_SECRET=whsec_...your_resend_webhook_signing_secret_here

# Runtime defaults
NODE_ENV=production
DEFAULT_CURRENCY=MXN
DEFAULT_COUNTRY=MX
TAX_RATE=0.16
VITE_TT_STORAGE_DISCOVERY_ENABLED=false
